# Copy this file to .env in this project directory.
# Never commit or share the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A direct public court case page is required before monitoring can start.
COURT_CASE_URL=
COURT_CASE_NUMBER=
COURT_CASE_URL_2=
COURT_CASE_NUMBER_2=

# Fixed schedule: Monday-Friday at 12:08 and 18:08 Europe/Moscow.
# These values are documented here for visibility and validated at startup.
COURT_TIME_ZONE=Europe/Moscow
COURT_POLL_TIMES=12:08,18:08
